<?xml version="1.0" ?>

<sdf version="1.9">

  <world name="joint_test_world">

    <!-- ==================== World Systems ==================== -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>


    <!-- ==================== Light ==================== -->

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.1 -0.9</direction>
    </light>


    <!-- ==================== Test Arm ==================== -->

    <model name="joint_test">

      <!-- ---------- Base ---------- -->

      <link name="base_link">

        <pose>0 0 0.1 0 0 0</pose>

        <inertial>
          <mass>2.0</mass>

          <inertia>
            <ixx>0.0267</ixx>
            <iyy>0.0267</iyy>
            <izz>0.0400</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="base_visual">
          <geometry>
            <cylinder>
              <radius>0.20</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>

        <collision name="base_collision">
          <geometry>
            <cylinder>
              <radius>0.20</radius>
              <length>0.20</length>
            </cylinder>
          </geometry>
        </collision>

      </link>


      <!-- ---------- Arm ---------- -->

      <link name="arm_link">

        <pose relative_to="base_link">
          0.35 0 0.30 0 0 0
        </pose>

        <inertial>
          <mass>0.30</mass>

          <inertia>
            <ixx>0.00032</ixx>
            <iyy>0.0124</iyy>
            <izz>0.0124</izz>

            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>

        <visual name="arm_visual">
          <geometry>
            <box>
              <size>0.70 0.08 0.08</size>
            </box>
          </geometry>

          <material>
            <ambient>0.15 0.35 0.70 1</ambient>
            <diffuse>0.20 0.45 0.90 1</diffuse>
          </material>
        </visual>

        <collision name="arm_collision">
          <geometry>
            <box>
              <size>0.70 0.08 0.08</size>
            </box>
          </geometry>
        </collision>

      </link>


      <!-- ---------- Fix Base To World ---------- -->

      <joint name="base_fixed" type="fixed">

        <parent>world</parent>
        <child>base_link</child>

      </joint>


      <!-- ---------- J1 ---------- -->

      <joint name="j1" type="revolute">

        <pose relative_to="base_link">
          0 0 0.30 0 0 0
        </pose>

        <parent>base_link</parent>
        <child>arm_link</child>

        <axis>

          <xyz>0 0 1</xyz>

          <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>

            <effort>20</effort>
            <velocity>2.0</velocity>
          </limit>

        </axis>

      </joint>


      <!-- ---------- J1 Position Controller ---------- -->

      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">

        <joint_name>j1</joint_name>

        <p_gain>10.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.5</d_gain>

        <cmd_max>20.0</cmd_max>
        <cmd_min>-20.0</cmd_min>

      </plugin>


    </model>

  </world>

</sdf>

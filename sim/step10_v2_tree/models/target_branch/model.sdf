<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="target_branch">

    <static>false</static>
    <self_collide>false</self_collide>

    <link name="target_branch_link">

      <inertial>
        <mass>2.1</mass>
        <inertia>
          <ixx>0.20</ixx>
          <iyy>0.20</iyy>
          <izz>0.010</izz>
        </inertia>
      </inertial>

      <!-- Inner 0.40 m: normal wood color -->
      <collision name="target_branch_inner_collision">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.40</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="target_branch_inner_visual">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.40</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>

      <!-- Outer 0.30 m: red debug / target segment -->
      <collision name="target_branch_outer_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="target_branch_outer_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.70 0.05 0.05 1</ambient>
          <diffuse>0.95 0.08 0.08 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

    </link>

  </model>
</sdf>

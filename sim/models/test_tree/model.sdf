<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="test_tree">

    <!-- ====================================================== -->
    <!-- Step 10 test tree (v3)                                 -->
    <!-- - lower branches: slightly longer / thicker            -->
    <!-- - upper branches: slightly shorter / thinner           -->
    <!-- - branches distributed more evenly around trunk        -->
    <!-- - all branches inserted slightly into trunk            -->
    <!-- - target branch split: fixed wood inner + detachable red outer -->
    <!-- ====================================================== -->

    <static>false</static>
    <self_collide>false</self_collide>


    <!-- ====================================================== -->
    <!-- Trunk                                                  -->
    <!-- ====================================================== -->

    <link name="trunk_link">
      <pose>0 0 1.50 0 0 0</pose>

      <inertial>
        <mass>40.0</mass>
        <inertia>
          <ixx>30.0</ixx>
          <iyy>30.0</iyy>
          <izz>0.30</izz>
        </inertia>
      </inertial>

      <collision name="trunk_collision">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>3.00</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="trunk_visual">
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>3.00</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.28 0.14 0.06 1</ambient>
          <diffuse>0.36 0.18 0.08 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>

    <joint name="trunk_world_joint" type="fixed">
      <parent>world</parent>
      <child>trunk_link</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Branch 1                                               -->
    <!-- lower / front-right, longer and thicker               -->
    <!-- ====================================================== -->

    <link name="branch_1">
      <pose>0.285 0.145 2.250 0 0.98 0.47</pose>

      <inertial>
        <mass>2.2</mass>
        <inertia>
          <ixx>0.20</ixx>
          <iyy>0.20</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <collision name="branch_1_collision">
        <geometry>
          <cylinder>
            <radius>0.048</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="branch_1_visual">
        <geometry>
          <cylinder>
            <radius>0.048</radius>
            <length>0.95</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="branch_1_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>branch_1</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Branch 2                                               -->
    <!-- lower / left-rear, longer and thicker                 -->
    <!-- ====================================================== -->

    <link name="branch_2">
      <pose>-0.255 0.260 2.350 0 1.02 2.35</pose>

      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.18</ixx>
          <iyy>0.18</iyy>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <collision name="branch_2_collision">
        <geometry>
          <cylinder>
            <radius>0.046</radius>
            <length>0.90</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="branch_2_visual">
        <geometry>
          <cylinder>
            <radius>0.046</radius>
            <length>0.90</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="branch_2_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>branch_2</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Branch 4                                               -->
    <!-- middle / rear-right                                   -->
    <!-- ====================================================== -->

    <link name="branch_4">
      <pose>-0.220 -0.300 2.450 0 1.04 -2.10</pose>

      <inertial>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.008</izz>
        </inertia>
      </inertial>

      <collision name="branch_4_collision">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.82</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="branch_4_visual">
        <geometry>
          <cylinder>
            <radius>0.042</radius>
            <length>0.82</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="branch_4_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>branch_4</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Branch 5                                               -->
    <!-- middle / front-left                                   -->
    <!-- ====================================================== -->

    <link name="branch_5">
      <pose>0.115 0.295 2.760 0 0.96 1.34</pose>

      <inertial>
        <mass>1.6</mass>
        <inertia>
          <ixx>0.13</ixx>
          <iyy>0.13</iyy>
          <izz>0.007</izz>
        </inertia>
      </inertial>

      <collision name="branch_5_collision">
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.78</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="branch_5_visual">
        <geometry>
          <cylinder>
            <radius>0.040</radius>
            <length>0.78</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="branch_5_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>branch_5</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Branch 6                                               -->
    <!-- high / right-rear, shorter and thinner                -->
    <!-- ====================================================== -->

    <link name="branch_6">
      <pose>0.150 -0.245 2.800 0 1.01 -1.00</pose>

      <inertial>
        <mass>1.3</mass>
        <inertia>
          <ixx>0.11</ixx>
          <iyy>0.11</iyy>
          <izz>0.006</izz>
        </inertia>
      </inertial>

      <collision name="branch_6_collision">
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.68</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="branch_6_visual">
        <geometry>
          <cylinder>
            <radius>0.034</radius>
            <length>0.68</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="branch_6_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>branch_6</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Target branch inner / stump segment                     -->
    <!-- This 0.40 m wood-colored part stays permanently fixed   -->
    <!-- to the tree. Its local frame is exactly the old         -->
    <!-- target_branch frame, so the outer detachable red part   -->
    <!-- still lines up at local z = 0.                          -->
    <!-- ====================================================== -->

    <link name="target_branch_inner_link">
      <pose>-0.305 0.060 2.950 0 1.08 2.961593</pose>

      <inertial>
        <pose>0 0 -0.20 0 0 0</pose>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.0164</ixx>
          <iyy>0.0164</iyy>
          <izz>0.00087</izz>
        </inertia>
      </inertial>

      <collision name="target_branch_inner_collision">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.40</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="target_branch_inner_visual">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.038</radius>
            <length>0.40</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.15 0.07 1</ambient>
          <diffuse>0.40 0.20 0.09 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="target_branch_inner_joint" type="fixed">
      <parent>trunk_link</parent>
      <child>target_branch_inner_link</child>
    </joint>


    <!-- ====================================================== -->
    <!-- Detachable red outer segment                           -->
    <!-- target_branch now contains ONLY the outer 0.30 m red   -->
    <!-- segment. Detaching therefore drops only the red part.  -->
    <!-- ====================================================== -->

    <plugin
      filename="gz-sim-detachable-joint-system"
      name="gz::sim::systems::DetachableJoint">

      <parent_link>target_branch_inner_link</parent_link>
      <child_model>target_branch</child_model>
      <child_link>target_branch_link</child_link>

      <detach_topic>/target_branch/detach</detach_topic>
      <attach_topic>/target_branch/attach</attach_topic>
      <output_topic>/target_branch/state</output_topic>

    </plugin>

  </model>
</sdf>

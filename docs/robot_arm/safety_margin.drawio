        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    A[\&quot;Camera + MID360&lt;br/&gt;目标枝条感知\&quot;] --&gt; B[\&quot;获取任务信息&lt;br/&gt;切割点 + 枝条方向 + 切割面\&quot;]\n\n    B --&gt; C[\&quot;TF 坐标变换&lt;br/&gt;统一到 base_link\&quot;]\n\n    C --&gt; D{\&quot;目标是否&lt;br/&gt;几何可达？\&quot;}\n\n    D -- \&quot;否\&quot; --&gt; E[\&quot;UAV 主动重定位&lt;br/&gt;调整 x / y / z / yaw\&quot;]\n    E --&gt; F[\&quot;更新目标相对位置\&quot;]\n    F --&gt; D\n\n    D -- \&quot;是\&quot; --&gt; G[\&quot;生成 IK 候选解&lt;br/&gt;J2 / J3 / J4\&quot;]\n\n    G --&gt; H[\&quot;安全与操作性能评价&lt;br/&gt;关节余量 · 奇异性 · 碰撞&lt;br/&gt;伸展程度 · 感知可见性 · 切割姿态\&quot;]\n\n    H --&gt; I{\&quot;安全裕度 S&lt;br/&gt;是否足够？\&quot;}\n\n    I -- \&quot;否：临界/不安全\&quot; --&gt; J[\&quot;重新选 IK 解&lt;br/&gt;或 UAV 重新规划\&quot;]\n    J --&gt; E\n\n    I -- \&quot;是：进入优选工作空间\&quot; --&gt; K[\&quot;选择最优关节构型\&quot;]\n\n    K --&gt; L[\&quot;轨迹规划&lt;br/&gt;机械臂运动到位\&quot;]\n\n    L --&gt; M[\&quot;链锯切割姿态确认\&quot;]\n\n    M --&gt; N[\&quot;开链锯 → 接触目标&lt;br/&gt;执行切割\&quot;]\n\n    N --&gt; O[\&quot;切割完成检测\&quot;]\n\n    O --&gt; P[\&quot;机械臂安全回撤\&quot;]\n\n    P --&gt; Q[\&quot;任务完成 / 下一目标\&quot;]\n\n\n    classDef perception fill:#DCEEFF,stroke:#3B82F6,stroke-width:1.5px,color:#111;\n    classDef decision fill:#FFF1C7,stroke:#E5A100,stroke-width:2px,color:#111;\n    classDef replan fill:#FFE0E0,stroke:#E05252,stroke-width:1.5px,color:#111;\n    classDef safe fill:#DDF5E3,stroke:#36A269,stroke-width:1.5px,color:#111;\n    classDef action fill:#EAE4FF,stroke:#7657C8,stroke-width:1.5px,color:#111;\n\n    class A,B,C perception;\n    class D,I decision;\n    class E,F,J replan;\n    class G,H,K safe;\n    class L,M,N,O,P,Q action;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="uOysEHxU5Jo3bV-s99HV-135">
